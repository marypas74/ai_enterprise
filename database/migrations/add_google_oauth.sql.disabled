((SELECT id FROM ai_providers WHERE name = 'google_oauth'), 'gemini-1.5-flash', 'Gemini 1.5 Flash', 'Fast and versatile', 1000000, 8192, 0, 0, TRUE, TRUE, TRUE, TRUE, FALSE, 3);

