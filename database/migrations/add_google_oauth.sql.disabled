-- Add Google OAuth provider if it doesn't exist
INSERT IGNORE INTO ai_providers (name, display_name, provider_type, is_enabled, is_local, config_schema) VALUES
('google_oauth', 'Google (OAuth)', 'google', FALSE, FALSE, '{
  "type": "object",
  "required": [],
  "properties": {
    "oauth_token": {
      "type": "string",
      "title": "OAuth Token",
      "description": "OAuth access token (managed automatically)",
      "format": "password"
    },
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "Google Cloud OAuth Client ID"
    },
    "client_secret": {
      "type": "string",
      "title": "Client Secret",
      "description": "Google Cloud OAuth Client Secret",
      "format": "password"
    }
  }
}');

-- Add Google OAuth models
